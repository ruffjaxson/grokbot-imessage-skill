<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jeffhuber.grokbot-imessage-watch launchd agent.

  Every 60 seconds, runs watch_tick.sh as the user (no Full Disk Access). It
  asks the helper, through the normal bridge, how many new messages arrived
  from watched contacts. If there are any, it POSTs a content-free trigger
  to the Grok Bot routine webhook configured in <bridge>/watch/webhook.json.
  With no webhook configured, it exits without doing anything.

  Filled in by install-hardened.sh: {{CODE_ROOT}} (root-owned code) and
  {{BRIDGE_ROOT}} (user-owned bridge).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jeffhuber.grokbot-imessage-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{CODE_ROOT}}/tools/watch_tick.sh</string>
    <string>{{BRIDGE_ROOT}}</string>
  </array>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/dev/null</string>

  <key>StandardErrorPath</key>
  <string>/dev/null</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
